{"kind":"shape","id":"sh/dgbulwnm","slideIndex":4,"position":{"left":0,"top":0,"width":960,"height":76.8},"name":"Shape 0","geometry":"rect","fillColor":"#1F4788","style":{"fontSize":24,"typeface":"Calibri","color":"#000000","alignment":"left"}}
