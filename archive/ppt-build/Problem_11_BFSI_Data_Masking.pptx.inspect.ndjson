{"kind":"textbox","id":"sh/b29kza94","slideIndex":1,"position":{"left":48,"top":105.6,"width":864,"height":33.6},"name":"Text 2","text":"Problem Statement","geometry":"rect","style":{"fontSize":26.67,"typeface":"Calibri","color":"#1F4788","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/a10jqpsj","slideIndex":1,"position":{"left":67.2,"top":148.8,"width":825.6,"height":144},"name":"Text 3","text":"Sensitive customer fields can reach internal users who do not need the full values.\nSupport staff, analysts and administrators need different levels of access.\nThe task is to protect query results across databases while preserving the original records.","geometry":"rect","style":{"fontSize":20,"typeface":"Calibri","color":"#303030","alignment":"left"}}
{"kind":"textbox","id":"sh/x4r21kru","slideIndex":1,"position":{"left":48,"top":307.2,"width":864,"height":33.6},"name":"Text 4","text":"Market Opportunity","geometry":"rect","style":{"fontSize":26.67,"typeface":"Calibri","color":"#1F4788","bold":true,"alignment":"left"}}
{"kind":"textbox","id":"sh/w3i1sfa9","slideIndex":1,"position":{"left":67.2,"top":350.4,"width":825.6,"height":124.8},"name":"Text 5","text":"Initial users: financial institutions with support and analytics teams.\nProposed adoption: pilot a few sensitive tables, then expand approved policies.\nBaseline: manually tagged fields or separate masked copies. We propose one reusable policy layer.","geometry":"rect","style":{"fontSize":20,"typeface":"Calibri","color":"#303030","alignment":"left"}}
